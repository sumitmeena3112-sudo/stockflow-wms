generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: ADMIN (office team) | PICKER (warehouse team)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("PICKER")
  createdAt    DateTime @default(now())
}

model Warehouse {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  isMain Boolean @default(false) // orders only ship from the main warehouse

  locations Location[]
}

model Location {
  id          String @id @default(cuid())
  code        String @unique
  warehouseId String

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  stock     StockLevel[]
  movements StockMovement[]
}

model Product {
  id        String   @id @default(cuid())
  sku       String   @unique // one SKU per variant
  name      String
  variant   String?
  createdAt DateTime @default(now())

  stock         StockLevel[]
  orderLines    OrderLine[]
  movements     StockMovement[]
  deliveryLines DeliveryLine[]
}

model StockLevel {
  id         String @id @default(cuid())
  productId  String
  locationId String
  onHand     Int    @default(0)
  reserved   Int    @default(0)

  product     Product      @relation(fields: [productId], references: [id])
  location    Location     @relation(fields: [locationId], references: [id])
  allocations Allocation[]

  @@unique([productId, locationId])
}

model Courier {
  id         String  @id @default(cuid())
  code       String  @unique
  name       String
  cost       Float // per parcel
  speedDays  Int // typical delivery time
  pickupTime String // daily pickup, "HH:MM" 24h
  active     Boolean @default(true)

  orders Order[]
}

// status: RECEIVED | PROCESSED | PICKING | PACKING | STAGED | SHIPPED | CANCELLED
// priority: PRIORITY | STANDARD
model Order {
  id              String    @id @default(cuid())
  reference       String    @unique
  channel         String    @default("Website")
  customer        String
  address         String    @default("")
  priority        String    @default("STANDARD")
  dueAt           DateTime // ship-by deadline
  status          String    @default("RECEIVED")
  statusUpdatedAt DateTime  @default(now())
  courierId       String?
  trackingNumber  String?
  stagingSlot     String?
  createdAt       DateTime  @default(now())
  shippedAt       DateTime?

  courier Courier?     @relation(fields: [courierId], references: [id])
  lines   OrderLine[]
  events  OrderEvent[]
  issues  Issue[]
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  picked    Int     @default(0)
  packed    Boolean @default(false) // item verified into the box

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  allocations Allocation[]
}

// A reservation of stock from one bin for one order line (this is the pick list).
// needsTransfer: the stock is in the overflow warehouse and must be moved to
// transferToLocationId (a main-warehouse bin) before it can be picked.
model Allocation {
  id                 String  @id @default(cuid())
  orderLineId        String
  stockLevelId       String
  quantity           Int
  picked             Boolean @default(false)
  needsTransfer      Boolean @default(false)
  transferToLocationId String?

  orderLine  OrderLine  @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  stockLevel StockLevel @relation(fields: [stockLevelId], references: [id])
}

// Audit trail: every step, who did it, and when.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  message   String
  actor     String   @default("system")
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// type: STOCK_SHORT | WRONG_ITEM | DAMAGED | MISSING_ITEM | MISSED_PICKUP | DELIVERY | OTHER
// status: OPEN | RESOLVED
model Issue {
  id             String    @id @default(cuid())
  orderId        String?
  type           String
  description    String
  status         String    @default("OPEN")
  reportedBy     String    @default("system")
  resolutionNote String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

// Inbound delivery: EXPECTED -> CHECKED (counted, damage noted) -> PUT_AWAY (on shelves, sellable)
model Delivery {
  id         String   @id @default(cuid())
  reference  String   @unique
  supplier   String
  status     String   @default("EXPECTED")
  expectedAt DateTime
  createdAt  DateTime @default(now())

  lines DeliveryLine[]
}

model DeliveryLine {
  id          String  @id @default(cuid())
  deliveryId  String
  productId   String
  expectedQty Int
  receivedQty Int     @default(0)
  damagedQty  Int     @default(0)
  locationId  String?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

// type: INBOUND | OUTBOUND | TRANSFER
model StockMovement {
  id         String   @id @default(cuid())
  productId  String
  locationId String
  delta      Int
  type       String
  note       String?
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
}
